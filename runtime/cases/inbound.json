    {
      "id": "inbound_book_referral_present",
      "title": "Кардиолог с направлением (получено не раньше месяца назад) → запись к кардиологу",
      "flow": "inbound", "caller_phone": "79035551234",
      "steps": [
        {"wait": "inbound.welcome", "dtmf": "1"},
        {"wait": "inbound.id_self_or_other", "dtmf": "1"},
        {"wait": "inbound.id_birth_check", "digits": "12051980"},
        {"wait": "inbound.book_start", "dtmf": "6"},
        {"wait": "inbound.book_ask_specialty", "say": "к кардиологу"},
