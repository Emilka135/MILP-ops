    {
      "id": "inbound_reschedule_existing",
      "title": "Перенос существующей записи: ближайший день → да → до обеда → ближайшее время → да",
      "flow": "inbound", "caller_phone": "79035551234",
      "setup": {"bookings": [{"remote_id": "APT-102", "patient_id": 1, "doctor": 2, "starts_at": "2026-10-15T15:30"}]},
      "steps": [
        {"wait": "inbound.welcome", "dtmf": "2"},
        {"wait": "inbound.id_self_or_other", "dtmf": "1"},
        {"wait": "inbound.id_birth_check", "digits": "12051980"},
        {"wait": "inbound.existing_menu", "dtmf": "2"},
        {"wait": "reschedule.rs_offer_day", "dtmf": "1"},
        {"wait": "reschedule.rs_ask_part", "dtmf": "1"},
        {"wait": "reschedule.rs_offer_time", "dtmf": "1"}
      ],
      "expect": {
        "status": "rescheduled", "transfer": false, "sms_contains": "Иван Иванович",
        "stand": [{"method": "PATCH", "path": "/api/v1/appointments/APT-102", "status": 200, "body": {"starts_at": "~T(0[89]|1[0-3]):"}}],
        "mirror": {"APT-102": "booked"}
      }
    },
    {
      "id": "inbound_info_schedule_no_writes",
      "title": "Справка о режиме работы: ничего не пишем в стенд",
      "flow": "inbound", "caller_phone": "79035551234",
      "steps": [
        {"wait": "inbound.welcome", "dtmf": "3"},
