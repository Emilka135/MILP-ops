    {
      "id": "inbound_cancel_existing",
      "title": "Отмена существующей записи (сделанной регистратором, id стенда APT-100)",
      "flow": "inbound", "caller_phone": "79035551234",
      "setup": {"bookings": [{"remote_id": "APT-100", "patient_id": 1, "doctor": 2, "starts_at": "2026-10-15T15:00"}]},
      "steps": [
        {"wait": "inbound.welcome", "dtmf": "2"},
        {"wait": "inbound.id_self_or_other", "dtmf": "1"},
        {"wait": "inbound.id_birth_check", "digits": "12051980"},
        {"wait": "inbound.existing_menu", "dtmf": "0"},
        {"wait": "inbound.cancel_confirm", "dtmf": "1"}
      ],
      "expect": {
        "status": "cancelled", "transfer": false, "sms_contains": "Иван Иванович",
        "stand": [{"method": "DELETE", "path": "/api/v1/appointments/APT-100", "status": 200}],
        "mirror": {"APT-100": "cancelled"}
      }
    },
    {
      "id": "inbound_cancel_declined",
      "title": "Передумал отменять (2 — оставить запись), затем подтвердил (1) → confirm, без отмены",
      "flow": "inbound", "caller_phone": "79035551234",
      "setup": {"bookings": [{"remote_id": "APT-101", "patient_id": 1, "doctor": 2, "starts_at": "2026-10-15T15:15"}]},
      "steps": [
        {"wait": "inbound.welcome", "dtmf": "2"},
        {"wait": "inbound.id_self_or_other", "dtmf": "1"},
        {"wait": "inbound.id_birth_check", "digits": "12051980"},
        {"wait": "inbound.existing_menu", "dtmf": "0"},
        {"wait": "inbound.cancel_confirm", "dtmf": "2"},
        {"wait": "inbound.existing_menu", "dtmf": "1"}
      ],
      "expect": {
        "status": "confirmed", "transfer": false,
        "stand": [{"method": "POST", "path": "/api/v1/appointments/APT-101/confirm", "status": 200}],
        "mirror": {"APT-101": "booked"}
