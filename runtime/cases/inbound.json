{
  "description": "Входящие звонки: вход = действия звонящего (клавиши DTMF / речь / тишина), выход = записи, которые должны появиться в стенде через API (и статус звонка). today = 2026-10-14 (среда), демо-расписание seed_demo, пациент 1 = Иванов И.И. (тел. 79035551234, ДР 12.05.1980, СНИЛС 12345678901, карта 1001), пациент 3 = Петрова М.С. (тел. 79165550000, карта 1003).",
  "cases": [
    {
      "id": "inbound_book_dtmf",
      "title": "Запись к терапевту клавишами: номер известен, подтверждение датой рождения",
      "flow": "inbound", "caller_phone": "79035551234",
      "steps": [
        {"wait": "inbound.welcome", "dtmf": "1"},
        {"wait": "inbound.id_self_or_other", "dtmf": "1"},
        {"wait": "inbound.id_birth_check", "digits": "12051980"},
        {"wait": "inbound.book_start", "dtmf": "1"},
        {"wait": "inbound.book_offer", "dtmf": "1"}
      ],
      "expect": {
        "status": "booked", "transfer": false, "sms_contains": "Иван Иванович",
        "vars": {"specialty": "терапевт"},
        "stand": [{"method": "POST", "path": "/api/v1/appointments", "status": 201, "body": {"patient_id": 1, "source": "voice-bot", "call_id": "case-inbound_book_dtmf"}}]
      }
    },
    {
      "id": "inbound_book_speech_surgeon_friday",
      "title": "60 с без нажатий → речь: «к хирургу в пятницу после обеда», согласие голосом",
      "flow": "inbound", "caller_phone": "79035551234",
      "steps": [
        {"wait": "inbound.welcome", "timeout": true},
        {"wait": "inbound.listen_free", "say": "запишите меня к хирургу в пятницу после обеда"},
        {"wait": "inbound.id_self_or_other", "dtmf": "1"},
        {"wait": "inbound.id_birth_check", "digits": "12051980"},
        {"wait": "inbound.book_offer", "say": "да, подходит"}
      ],
      "expect": {
        "status": "booked", "transfer": false,
        "vars": {"specialty": "хирург", "slot_date": "2026-10-16"},
        "stand": [{"method": "POST", "path": "/api/v1/appointments", "body": {"patient_id": 1, "starts_at": "~^2026-10-16T1[4-9]"}}]
      }
    },
    {
      "id": "inbound_book_other_person_by_card",
      "title": "Запись другого человека: идентификация номером карты (1003#), SMS с именем записанного",
      "flow": "inbound", "caller_phone": "79035551234",
      "steps": [
        {"wait": "inbound.welcome", "dtmf": "1"},
        {"wait": "inbound.id_self_or_other", "dtmf": "2"},
        {"wait": "inbound.id_ask_method", "dtmf": "2"},
        {"wait": "inbound.id_ask_card", "digits": "1003#"},
        {"wait": "inbound.book_start", "dtmf": "2"},
        {"wait": "inbound.book_offer", "dtmf": "1"}
      ],
      "expect": {
        "status": "booked", "transfer": false, "sms_contains": "Мария Сергеевна",
        "vars": {"specialty": "педиатр", "patient_id": 3},
        "stand": [{"method": "POST", "path": "/api/v1/appointments", "body": {"patient_id": 3}}]
      }
    },
    {
      "id": "inbound_book_unknown_phone_snils",
      "title": "Номер неизвестен → СНИЛС (11 цифр)",
      "flow": "inbound", "caller_phone": "79990001122",
      "steps": [
        {"wait": "inbound.welcome", "dtmf": "1"},
        {"wait": "inbound.id_ask_method", "dtmf": "1"},
        {"wait": "inbound.id_ask_snils", "digits": "32345678901"},
        {"wait": "inbound.book_start", "dtmf": "4"},
        {"wait": "inbound.book_offer", "dtmf": "1"}
      ],
      "expect": {
        "status": "booked", "transfer": false,
        "vars": {"specialty": "офтальмолог", "patient_id": 3},
        "stand": [{"method": "POST", "path": "/api/v1/appointments", "body": {"patient_id": 3}}]
      }
    },
    {
      "id": "inbound_book_referral_missing",
      "title": "Узкий специалист без направления → запись к терапевту (не к кардиологу)",
      "flow": "inbound", "caller_phone": "79035551234",
