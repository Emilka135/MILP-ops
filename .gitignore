# ---------------------------------------------------------------------------
# Секреты и локальные настройки — НИКОГДА не коммитить
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
var/token.txt
*.token

# ---------------------------------------------------------------------------
# Рабочие данные приложения (создаются при запуске).
# Правило именно `var/*`, а не `var/`: иначе каталог исключается целиком и
# пояснение var/README.md внутрь репозитория уже не попадает.
# ---------------------------------------------------------------------------
var/*
!var/README.md

# Кэш справочника врачей и оффлайн-стенд (перечислять не нужно: всё в var/*
# уже исключено, здесь только для наглядности при чтении файла)
# var/doctors_cache.json
# var/mock_stand.json
# var/mock_seed.json
# var/local_store.json
# var/acceptance_report.json

# ---------------------------------------------------------------------------
# Выгрузки заказчика: 7,5 МБ CSV, не место в репозитории.
# Восстанавливаются командой: python tools/fetch_data.py
# ---------------------------------------------------------------------------
data/raw/

# ---------------------------------------------------------------------------
# Python
