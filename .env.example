# Demo runs entirely locally. Switch to live only after importing the stand's IDs and local model files.
APP_MODE=demo
HTTP_PORT=8080
API_TOKEN=
CLINIC_NAME=Демонстрационная поликлиника
CLINIC_PHONE=+7 (000) 000-00-00

# Actual contract: base URL includes /api/v1. No /appointments or /confirm endpoint.
STAND_URL=
STAND_TOKEN=
# On the hackathon VM this alias is already supplied in /opt/hackathon/ai.env.
DBI_API_TOKEN=
# Live example: STAND_URL=https://crm-med-mock.dbi-testing.ru/api/v1
# Paths inside the containers; put canonical CSV/XLSX files in ./imports.
CRM_SCHEDULE=
CRM_PATIENTS=
CRM_BOOKINGS=
# Empty uses the clinic's current GMT+4 time. Frozen times are for tests only.
CRM_NOW=
OPERATOR_AVAILABLE=1

# Build extras and models; both real speech services fail startup if models are missing in live mode.
WITH_ML=1
WITH_BGE=0
NLU_EMBEDDER=hash
TTS_SPEAKER=ru_ekaterina
ASR_MODEL=gigaam-v3-e2e-rnnt

# HTTP gateway contract: POST {to,text}, Idempotency-Key header, response {id}.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# Asterisk/SIP settings. Keep outbound disabled until publication and trunk setup are complete.
ARI_PASSWORD=
SIP_PHONE_PASSWORD=
SIP_OPERATOR_PASSWORD=
AUDIOSOCKET_ADVERTISE=127.0.0.1:9092
SIP_OUTBOUND_ENDPOINT=
OUTBOUND_ENABLED=0
ANTI_FRAUD_PUBLISHED=0

# Visual editor and bounded slot agent: deterministic, openrouter or openai
EDITOR_PORT=8090
AGENT_MODE=deterministic
# Launcher sets the host UID/GID so the model can read locally protected 0600 keys.
CLINIC_LOCAL_UID=1000
CLINIC_LOCAL_GID=1000
OPENROUTER_MODEL=
OPENAI_BASE_URL=https://hub.gigaschool.ru/api/v1/llm/v1
OPENAI_MODEL=
# Local provider key: python tools/configure_openrouter.py --provider openai
# Put the key in ignored secrets/openrouter.key; do not put it in scenario files.

# Registrar schedule imports into the same relational clinic database
CRM_ASSIGNMENTS=
CRM_SERVICE_HOURS=
CRM_SERVICE_CALENDAR=

# Enable only with the optional builder profile
EDITOR_ALLOW_BUILD=0

# Optional local NVIDIA ASR: ./clinic start --gpu
CLINIC_GPU_DEVICE=0
ASR_GPU_MEM_LIMIT_MIB=1024
ASR_GPU_QUANTIZATION=none
