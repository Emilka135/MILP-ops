# ---------------------------------------------------------------------------
# Настройки демо голосового ассистента регистратуры.
#
# Скопируйте этот файл в .env и заполните нужное:
#     Copy-Item .env.example .env        (Windows PowerShell)
#     cp .env.example .env               (Linux/macOS)
#
# Файл .env НЕ коммитится (см. .gitignore): в нём токен команды.
# Приоритет настроек: аргумент командной строки → переменная окружения →
# .env → var/token.txt → значение по умолчанию.
# ---------------------------------------------------------------------------

# Токен команды для тестового стенда «Регистратура».
# Выдаётся организаторами хакатона в административной панели.
# Без токена демо полностью работает в оффлайн-режиме на локальном двойнике,
# а вызовы API помечаются source=MOCK в панели «Вызовы API».
MIS_TOKEN=

# Базовый URL стенда. По умолчанию берётся из спецификации:
# https://crm-med-mock.dbi-testing.ru/api/v1
# Меняйте только если организаторы дали другой адрес.
MIS_BASE_URL=

# Адрес и порт веб-демо (по умолчанию 127.0.0.1:8000).
# Микрофон в браузере работает только на http://127.0.0.1:<порт>.
HOST=127.0.0.1
PORT=8000

# Горизонт записи в днях (регламент: 14 календарных дней).
HORIZON_DAYS=14

# Подробный лог HTTP-сервера: 1 — печатать каждый запрос.
# ASSISTANT_VERBOSE=1

# Свой путь к файлу с настройками (по умолчанию — .env рядом с проектом).
# DSH_ENV_FILE=
