# Demo runs entirely locally. Switch to live only after importing the stand's IDs and local model files.
APP_MODE=demo
HTTP_PORT=8080
API_TOKEN=
CLINIC_NAME=Демонстрационная поликлиника
CLINIC_PHONE=+7 (000) 000-00-00

# Actual contract: base URL includes /api/v1. No /appointments or /confirm endpoint.
STAND_URL=
STAND_TOKEN=
# Live example: STAND_URL=https://crm-med-mock.dbi-testing.ru/api/v1
# Paths inside the containers; put canonical CSV/XLSX files in ./imports.
CRM_SCHEDULE=
CRM_PATIENTS=
CRM_BOOKINGS=
# Empty uses the clinic's current GMT+4 time. Frozen times are for tests only.
CRM_NOW=
OPERATOR_AVAILABLE=1
OPERATOR_OPEN_HOUR=10
OPERATOR_CLOSE_HOUR=22

# Build extras and models; both real speech services fail startup if models are missing in live mode.
WITH_ML=1
WITH_BGE=0
NLU_EMBEDDER=hash
TTS_SPEAKER=xenia
ASR_MODEL=gigaam-v3-e2e-rnnt

# HTTP gateway contract: POST {to,text}, Idempotency-Key header, response {id}.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# Asterisk/SIP settings. Keep outbound disabled until publication and trunk setup are complete.
ARI_PASSWORD=
SIP_PHONE_PASSWORD=
SIP_OPERATOR_PASSWORD=
AUDIOSOCKET_ADVERTISE=127.0.0.1:9092
SIP_OUTBOUND_ENDPOINT=
OUTBOUND_ENABLED=0
ANTI_FRAUD_PUBLISHED=0
